/*
 * Lily58 keymap: modified Dvorak for a German (de) host keyboard layout.
 *
 * Layers
 *   0  Dvorak   default
 *   1  Symbol   hold Space
 *   2  Umlaut   hold Tab
 *   3  Numpad   toggle with the left outer thumb key (press again to leave)
 *   4  Fn       hold the right outer thumb key
 *
 * The DE_* key codes come from the zmk-locales module (see config/west.yml).
 * They encode what the host prints when it is set to the German layout, e.g.
 * DE_LEFT_BRACKET = AltGr+8 and DE_Y = the HID "Z" key.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <locale/keys_de.h>

/ {
    behaviors {
        // Space: tap = Space, hold = Symbol layer.
        lt_spc: layer_tap_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;          // tap, then hold within 175 ms = auto-repeat Space
            require-prior-idle-ms = <100>; // Space < 100 ms after a letter is always a tap (prose safety)
            bindings = <&mo>, <&kp>;
        };

        // Tab: tap = Tab, hold = Umlaut layer. No prior-idle so umlauts can be rolled at speed.
        lt_tab: layer_tap_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };

        // Left thumb #2: tap = ESC, hold = ALT. "balanced" keeps a rolled ESC+':' as ESC
        // while Alt held + Tab tapped resolves to Alt+Tab.
        mt_esc: mod_tap_esc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        // On the German layout ` and ^ are dead keys; dead key + Space emits the bare character.
        m_grave: m_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_GRAVE &kp SPACE>;
        };

        m_caret: m_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_CARET &kp SPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Dvorak";
// ------------------------------------------------------------------------------------------------------------
// |  !    |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   ?   |
// |  ;    |  #  |  ,  |  .   |  P   |  Y   |                   |  F   |  G    |  C    |  R   |   L   |   :   |
// | CTRL  |  A  |  O  |  E   |  U   |  I   |                   |  D   |  H    |  T    |  N   |   S   |   -   |
// | SHIFT |  "  |  Q  |  J   |  K   |  X   |   "["  |  |  "]"  |  B   |  M    |  W    |  V   |   Z   |  GUI  |
//                     |NUMPAD|ESC/ALT|SPC/SYM|TAB/UML|  | ENTER | BSPC | DEL   |  FN   |
            bindings = <
&kp DE_EXCLAMATION &kp N1               &kp N2       &kp N3        &kp N4           &kp N5                                                    &kp N6   &kp N7   &kp N8  &kp N9  &kp N0   &kp DE_QUESTION
&kp DE_SEMICOLON   &kp DE_HASH          &kp DE_COMMA &kp DE_PERIOD &kp P            &kp DE_Y                                                  &kp F    &kp G    &kp C   &kp R   &kp L    &kp DE_COLON
&kp LCTRL          &kp A                &kp O        &kp E         &kp U            &kp I                                                     &kp D    &kp H    &kp T   &kp N   &kp S    &kp DE_MINUS
&kp LSHFT          &kp DE_DOUBLE_QUOTES &kp Q        &kp J         &kp K            &kp X           &kp DE_LEFT_BRACKET  &kp DE_RIGHT_BRACKET &kp B    &kp M    &kp W   &kp V   &kp DE_Z &kp RGUI
                                                     &tog 3        &mt_esc LALT ESC &lt_spc 1 SPACE &lt_tab 2 TAB        &kp RET              &kp BSPC &kp DEL  &mo 4
            >;
        };

        symbol_layer {
            display-name = "Symbol";
// Hold Space. Keys in (parentheses) fall through to the default layer.
// ------------------------------------------------------------------------------------------------------------
// |  (!)  | (1) | (2) | (3)  | (4)  | (5)  |                   | (6)  | (7)   | (8)   | (9)  |  (0)  |  (?)  |
// |  (;)  |  '  |  <  |  $   |  >   |  `   |                   | (F)  |  [    |  _    |  ]   |   @   |  (:)  |
// |   -   |  \  |  (  |  "   |  )   |  #   |                   |  %   |  {    |  =    |  }   |   |   |  (-)  |
// |(SHIFT)| (") |  ;  |  *   |  +   | (X)  |  ("[") |  | ("]") |  /   |  &    |  ^    |  ~   |  (Z)  | (GUI) |
//                     |      |      |      |        |  |       |      |       |       |
            bindings = <
&trans       &trans              &trans                  &trans               &trans                   &trans                                  &trans         &trans              &trans            &trans               &trans         &trans
&trans       &kp DE_SINGLE_QUOTE &kp DE_LESS_THAN        &kp DE_DOLLAR        &kp DE_GREATER_THAN      &m_grave                                &trans         &kp DE_LEFT_BRACKET &kp DE_UNDERSCORE &kp DE_RIGHT_BRACKET &kp DE_AT_SIGN &trans
&kp DE_MINUS &kp DE_BACKSLASH    &kp DE_LEFT_PARENTHESIS &kp DE_DOUBLE_QUOTES &kp DE_RIGHT_PARENTHESIS &kp DE_HASH                             &kp DE_PERCENT &kp DE_LEFT_BRACE   &kp DE_EQUAL      &kp DE_RIGHT_BRACE   &kp DE_PIPE    &trans
&trans       &trans              &kp DE_SEMICOLON        &kp DE_ASTERISK      &kp DE_PLUS              &trans      &trans           &trans     &kp DE_SLASH   &kp DE_AMPERSAND    &m_caret          &kp DE_TILDE         &trans         &trans
                                                         &trans               &trans                   &trans      &trans           &trans     &trans         &trans              &trans
            >;
        };

        umlaut_layer {
            display-name = "Umlaut";
// Hold Tab. Shift (pass-through) gives the capitals.
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |  Ä  |  Ö  |      |  Ü   |      |                   |      |       |       |      |   ß   |       |
// |(SHIFT)|     |     |      |      |      |        |  |       |      |       |       |      |       |       |
//                     |      |      |      |        |  |       |      |       |       |
            bindings = <
&trans &trans          &trans          &trans &trans          &trans                      &trans &trans &trans &trans &trans         &trans
&trans &trans          &trans          &trans &trans          &trans                      &trans &trans &trans &trans &trans         &trans
&trans &kp DE_A_UMLAUT &kp DE_O_UMLAUT &trans &kp DE_U_UMLAUT &trans                      &trans &trans &trans &trans &kp DE_SHARP_S &trans
&trans &trans          &trans          &trans &trans          &trans    &trans    &trans  &trans &trans &trans &trans &trans         &trans
                                       &trans &trans          &trans    &trans    &trans  &trans &trans &trans
            >;
        };

        numpad_layer {
            display-name = "Numpad";
// Toggled by the left outer thumb key; press it again (EXIT) to leave.
// ------------------------------------------------------------------------------------------------------------
// |       | BT1 | BT2 | BT3  | BT4  | BT5  |                   | NUM  |  7    |  8    |  9   |   -   |       |
// |       |     |     |      |      |      |                   |  /   |  4    |  5    |  6   |   +   |       |
// |       |BTCLR|     |BTNXT |BTPRV |      |                   |  *   |  1    |  2    |  3   | ENTER |       |
// |(SHIFT)|     |     |      |      |      |        |  |       |      |  0    |  0    |  ,   |       |       |
//                     | EXIT |      |      |        |  |       |      |       |       |
            bindings = <
&trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                      &kp KP_NUM      &kp N7 &kp N8 &kp N9       &kp KP_MINUS &trans
&trans &trans       &trans       &trans       &trans       &trans                            &kp KP_SLASH    &kp N4 &kp N5 &kp N6       &kp KP_PLUS  &trans
&trans &bt BT_CLR   &trans       &bt BT_NXT   &bt BT_PRV   &trans                            &kp KP_ASTERISK &kp N1 &kp N2 &kp N3       &kp KP_ENTER &trans
&trans &trans       &trans       &trans       &trans       &trans       &trans     &trans    &trans          &kp N0 &kp N0 &kp DE_COMMA &trans       &trans
                                              &trans       &trans       &trans     &trans    &trans          &trans &trans &trans
            >;
        };

        function_layer {
            display-name = "Fn";
// Hold the right outer thumb key.
// ------------------------------------------------------------------------------------------------------------
// |  F11  | F1  | F2  | F3   | F4   | F5   |                   | F6   | F7    | F8    | F9   |  F10  |  F12  |
// |       |     | HOME| UP   | END  | PGUP |                   |      | VOL+  | MUTE  |      |       |       |
// |       |     | LEFT| DOWN | RIGHT| PGDN |                   |      | VOL-  | PLAY  | PREV | NEXT  |       |
// |(SHIFT)|     |     |      |      |      |        |  |       |      |       |       |      |       |       |
//                     |      |      |      |        |  |       |      |       |       |
            bindings = <
&kp F11 &kp F1 &kp F2   &kp F3   &kp F4    &kp F5                              &kp F6 &kp F7       &kp F8     &kp F9     &kp F10    &kp F12
&trans  &trans &kp HOME &kp UP   &kp END   &kp PG_UP                           &trans &kp C_VOL_UP &kp C_MUTE &trans     &trans     &trans
&trans  &trans &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN                           &trans &kp C_VOL_DN &kp C_PP   &kp C_PREV &kp C_NEXT &trans
&trans  &trans &trans   &trans   &trans    &trans    &trans        &trans      &trans &trans       &trans     &trans     &trans     &trans
                                 &trans    &trans    &trans        &trans      &trans &trans       &trans     &trans
            >;
        };
    };
};
